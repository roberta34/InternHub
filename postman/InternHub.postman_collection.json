{
  "info": {
    "name": "InternHub - Sprint 2 (Students P1/P2 + Offers P3/P4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in listed order with a running InternHub API and a fresh test database. Create steps store generated IDs, UpdateOffer tracks optimistic concurrency versions, Delete steps run last. The collection includes Sprint 2 requests for Persons 1 through 4."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5202"
    },
    {
      "key": "apiVersion",
      "value": "v1"
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "offerId",
      "value": ""
    },
    {
      "key": "offerVersion",
      "value": "0"
    },
    {
      "key": "staleOfferVersion",
      "value": "0"
    },
    {
      "key": "updatedStudentEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CreateStudent",
      "item": [
        {
          "name": "Create - happy path (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueStudentSuffix = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('createdStudentEmail', 'ana.' + uniqueStudentSuffix + '@mail.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location header', () => pm.response.to.have.header('Location'));",
                  "const body = pm.response.json();",
                  "pm.test('Created Student email matches generated value', () => {",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('createdStudentEmail'));",
                  "});",
                  "const idPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
                  "pm.test('Response contains a valid non-empty GUID', () => {",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.id).to.match(idPattern);",
                  "});",
                  "if (pm.response.code === 201 && body.id && idPattern.test(body.id)) {",
                  "  pm.collectionVariables.set('studentId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/{{apiVersion}}/students",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ana Pop\",\n  \"email\": \"{{createdStudentEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create - invalid email (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/{{apiVersion}}/students",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ana Pop\",\n  \"email\": \"not-an-email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create - edge: trim + lowercase email (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEdgeSuffix = pm.variables.replaceIn('{{$guid}}');",
                  "const emailBeforeNormalization = 'ION.' + uniqueEdgeSuffix + '@Mail.com';",
                  "pm.collectionVariables.set('edgeStudentEmail', emailBeforeNormalization);",
                  "pm.collectionVariables.set('normalizedEdgeStudentEmail', emailBeforeNormalization.trim().toLowerCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Normalized', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.fullName).to.eql('Ion Ionescu');",
                  "  pm.expect(b.email).to.eql(pm.collectionVariables.get('normalizedEdgeStudentEmail'));",
                  "});",
                  "const body = pm.response.json();",
                  "const idPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
                  "pm.test('Response contains a valid non-empty GUID', () => {",
                  "  pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.id).to.match(idPattern);",
                  "});",
                  "if (pm.response.code === 201 && body.id && idPattern.test(body.id)) {",
                  "  pm.collectionVariables.set('studentId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/{{apiVersion}}/students",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"  Ion Ionescu  \",\n  \"email\": \"{{edgeStudentEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
