              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Missing Offer\",\n  \"companyName\": \"Example Company\",\n  \"requirements\": \"C#, SQL\",\n  \"deadline\": \"{{updateDeadline}}\",\n  \"maximumAvailableSlots\": 2,\n  \"version\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update Offer - stale Version Conflict (409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('updateDeadline', new Date(Date.now() + 45 * 24 * 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Conflict explains stale version', () => pm.expect(pm.response.text().toLowerCase()).to.include('stale version'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/{{apiVersion}}/offers/{{offerId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should Not Persist - Stale Update\",\n  \"companyName\": \"Should Not Persist Ltd\",\n  \"requirements\": \"C#, .NET 10, SQLite\",\n  \"deadline\": \"{{updateDeadline}}\",\n  \"maximumAvailableSlots\": 5,\n  \"version\": {{staleOfferVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Offer after Conflict - original data preserved (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const offer = pm.response.json();",
                  "pm.test('409 did not overwrite database state', () => {",
                  "  pm.expect(offer.title).to.eql('Updated Backend Internship');",
                  "  pm.expect(offer.companyName).to.eql('InternHub Demo Company 2');",
                  "  pm.expect(offer.version).to.eql(Number(pm.collectionVariables.get('offerVersion')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/{{apiVersion}}/offers/{{offerId}}"
          }
        }
      ]
    },
    {
      "name": "DeleteOffer",
      "item": [
        {
          "name": "Delete Offer - happy path (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Response body is empty', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/{{apiVersion}}/offers/{{offerId}}"
          }
        },
        {
          "name": "Delete Offer - already deleted (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/{{apiVersion}}/offers/{{offerId}}"
          }
        }
      ]
    }
  ]
}
